# Neon Postgres (set automatically when the Neon store is connected in Vercel)
DATABASE_URL=

# Neon Auth, for the /admin magic link (Neon Console → Auth)
NEON_AUTH_BASE_URL=
# Random 32+ character string that signs the session cookie (openssl rand -base64 32)
NEON_AUTH_COOKIE_SECRET=

# Comma-separated emails allowed into /admin
ADMIN_EMAILS=

# Charity: donations go to its Rallybound tribute page
NEXT_PUBLIC_CHARITY_NAME=National Kidney Foundation
NEXT_PUBLIC_FUNDRAISER_URL=

NEXT_PUBLIC_SITE_URL=https://kidney.carrieburns.net
# Random string used to hash IPs for the wall's rate limit
IP_SALT=
